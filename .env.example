# Server Configuration (Hanya digunakan saat berjalan lokal)
PORT=3000

# Supabase Credentials (Isi untuk menggunakan database cloud, kosongkan untuk fallback database JSON lokal)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# JWT Auth Secret (Digunakan untuk enkripsi cookie login admin, ganti dengan string acak yang kuat)
JWT_SECRET=supersecret-token-ss08-pencapaian-kerja-2026

# ===== GOOGLE SHEETS INTEGRATION (Opsional) =====
# Ambil dari Google Cloud Console > IAM & Admin > Service Accounts
# Panduan: Admin Dashboard > Google Sheets > Panduan Setup

# ID Spreadsheet (dari URL: docs.google.com/spreadsheets/d/[ID_INI]/edit)
GOOGLE_SHEETS_ID=

# Email Service Account (dari file JSON credentials)
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Private Key Service Account (dari file JSON credentials, ganti newline dengan \n)
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
