# Server Configuration (Hanya digunakan saat berjalan lokal)
PORT=3000

# Supabase Credentials (Isi untuk menggunakan database cloud, kosongkan untuk fallback database JSON lokal)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# JWT Auth Secret (Digunakan untuk enkripsi cookie login admin, ganti dengan string acak yang kuat)
JWT_SECRET=supersecret-token-ss08-pencapaian-kerja-2026
